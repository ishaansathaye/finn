# Copy to .env, fill locally, chmod 600 .env. Never commit real values.
APP_ENV=dev
DATABASE_URL=sqlite:///./finn.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required only for the optional webhook deployment. Prefer long polling.
TELEGRAM_WEBHOOK_SECRET=
LOCAL_TIMEZONE=America/Los_Angeles

# Optional AI enrichment. Research and deterministic scoring also run without it.
GEMINI_API_KEY=
GEMINI_MODEL_ANALYST=gemini-2.5-flash
STOCK_LLM_DAILY_REQUEST_BUDGET=12
# SEC requires an identifying contact in the user agent; supply your own.
SEC_USER_AGENT=finn/0.1 (your-name your-email@example.com)

# Optional market providers; free/public sources have coverage and rate limits.
TWELVE_DATA_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# Optional SnapTrade integration; configure only if you use it.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=finn-local-user

# Select one primary investment account, never a savings or agentic account.
PRIMARY_PORTFOLIO_ACCOUNT_EXTERNAL_ID=
CORE_STOCK_SYMBOLS=
EMPLOYMENT_EXCLUDED_STOCK_SYMBOLS=

# Private Robinhood auth is created interactively, not stored in this file.
ROBINHOOD_WRITE_SESSION_PATH=~/.finn/robinhood_write_session.json
ROBINHOOD_PREDICTION_RHS_ACCOUNT_NUMBER=
ROBINHOOD_PREDICTION_ACCOUNT_ID=
# Optional read-only snapshot from a separately deployed autonomous trader.
AGENTIC_TRADER_SNAPSHOT_PATH=/var/lib/agentic-trader/snapshots/latest.json
